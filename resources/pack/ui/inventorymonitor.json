// InventoryMonitor screen (generated by tools/generate-ui.php from tools/inventorymonitor.json.tpl, do not edit by hand).
//
// One resource-pack screen shows the whole monitored inventory, laid out like the right panel of the vanilla inventory
// screen. The server opens a plain chest window whose title is "§b§w§i§m" + title (MonitorSlots::SCREEN_KEY) and this
// pack draws its own screen over the vanilla one only then:
//
//   - the overlay is inserted into chest.small_chest_panel (classic UI, ui/chest_screen.json) and
//     pocket_containers.panel (pocket UI, ui/pocket_containers.json) with "modifications", so no vanilla screen is
//     redeclared and other packs that do the same still work
//   - the overlay's hosts are `ignored` unless $container_title contains the key
//   - each host holds the marker control "entity_ui_hide_vanilla"; the two vanilla files bind to it to hide the vanilla
//     chest while the marker exists
//   - every cell is a vanilla container item (chest.chest_grid_item) of the collection "container_items", so tap,
//     shift-click and drag behave like in a chest
//
// A container item is an input_panel, which does not take collection_index or collection_name (the content log reports
// them as unknown properties and every cell then shows slot 0). So each cell is a stack_panel that names the collection,
// holding a panel with the slot number as collection_index, holding the container item; the index is inherited.
//
// Slot contract (src/MonitorSlots.php):
//   0..8 hotbar, 9..35 main inventory, 36..39 armor, 40 offhand, 41 cursor (read-only), 42 name label (#hover_text),
//   43 model entity id (#hover_text, the quoted actor id of the puppet the server spawned for this viewer),
//   44 held hotbar slot (#hover_text "h<index>"), 45..71 ender chest,
//   72..73 tab icons (#item_id_aux of a chest and an ender chest)
//
// LAYOUT of the target panel, in GUI pixels from the top-left of its content (162 x 152):
//   armor        x=0       4 cells from y=0, like the vanilla armor column
//   model        x=20      black 52 x 70 box with the puppet (live_horse_renderer)
//   offhand      x=76      next to the bottom of the model
//   cursor       x=144     the last column, beside the model
//   items        y=76     inventory tab: 3 rows + hotbar; ender tab: 3 rows of the ender chest
// The frame around it has the name of the target as its title, and two square tabs, the inventory (a chest icon) and
// the ender chest (an ender chest icon), radio toggles on the client side only, stand on its top edge, as in the
// vanilla tabbed screens.
// Classic UI: two frames of the same height side by side, the target on the left and the viewer's own inventory (vanilla
// collections) with the close button on the right.
// Pocket UI: the target frame in the vanilla container half (the right half); the vanilla inventory half (the left half,
// with its scrolling grid) stays.
{
  "namespace": "inventorymonitor",

  // One slot of the screen: $index is the slot number, $overlay an optional control drawn on the empty cell.
  "cell": {
    "type": "stack_panel",
    "size": [ 18, 18 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "collection_name": "container_items",
    "$overlay|default": "common.cell_overlay",
    "controls": [
      {
        "slot": {
          "type": "panel",
          "size": [ 18, 18 ],
          "collection_index": "$index",
          "controls": [
            { "item@chest.chest_grid_item": { "$cell_overlay_ref": "$overlay" } }
          ]
        }
      }
    ]
  },

  // The vanilla empty armor / shield silhouette, shown while the cell is empty. It reads #item_id_aux (0 or -1 when
  // empty): #hover_text is emptied for a few frames on every press and would show the silhouette over the item.
  "silhouette": {
    "type": "image",
    "layer": 2,
    "size": [ 16, 16 ],
    "texture": "$silhouette",
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#item_id_aux", "binding_condition": "always" },
      { "binding_type": "view", "source_property_name": "(#item_id_aux < 1)", "target_property_name": "#visible" }
    ]
  },
  "helmet@inventorymonitor.silhouette": { "$silhouette": "textures/ui/empty_armor_slot_helmet" },
  "chestplate@inventorymonitor.silhouette": { "$silhouette": "textures/ui/empty_armor_slot_chestplate" },
  "leggings@inventorymonitor.silhouette": { "$silhouette": "textures/ui/empty_armor_slot_leggings" },
  "boots@inventorymonitor.silhouette": { "$silhouette": "textures/ui/empty_armor_slot_boots" },
  "shield@inventorymonitor.silhouette": { "$silhouette": "textures/ui/empty_armor_slot_shield" },

  // A caption. $text is a key of texts/<lang>.lang
  "caption": {
    "type": "label",
    "layer": 2,
    "size": [ "100%", 10 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "shadow": false,
    "color": [ 0.25, 0.25, 0.25 ],
    "text": "$text",
    "$text|default": ""
  },

  // The name of the item in a data slot (42..44), kept in #saved. #hover_text is the tooltip text and the client
  // empties it for a few frames on every press in the screen, so whatever reads it directly blinks; the latch copies it
  // only when it turns to a new non-empty value (bedrock-research, bindings BND-18). The panel starts hidden so the
  // first value also changes its visibility. Readers find it by name with source_control_name.
  "latch": {
    "type": "panel",
    "size": [ 0, 0 ],
    "visible": false,
    "property_bag": { "#saved": "" },
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_name_override": "#saved", "binding_condition": "visibility_changed" },
      { "binding_type": "view", "source_property_name": "((not (#hover_text = '')) and (not (#hover_text = #saved)))", "target_property_name": "#visible" }
    ]
  },
  "latches": {
    "type": "stack_panel",
    "size": [ 0, 0 ],
    "collection_name": "container_items",
    "controls": [
      { "inventorymonitor_data@inventorymonitor.latch": { "collection_index": 42 } },
      { "inventorymonitor_model@inventorymonitor.latch": { "collection_index": 43 } },
      { "inventorymonitor_held@inventorymonitor.latch": { "collection_index": 44 } }
    ]
  },

  // The window title: the name and status of the target, sent by the server as the name of the item in slot 42
  // (DataSlot). The italic and reset codes of item names are removed, color codes stay. The server colors the name
  // (light colors such as §b and §7), so the label has a shadow like an item name.
  "title": {
    "type": "panel",
    "size": [ "100% - 40px", 10 ],
    "offset": [ 0, 6 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 2,
          "size": [ "100%", 10 ],
          "text_alignment": "center",
          "shadow": true,
          "color": [ 0.25, 0.25, 0.25 ],
          "text": "#text",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "inventorymonitor_data",
              "source_property_name": "(#saved - '§o' - '§f' - '§r')",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },

  // The model: the server spawns a puppet player for this viewer and writes its actor id, quoted, as the name of the
  // item in slot 43. live_horse_renderer reads #entity_id as a string and converts it to the id; a bare number would be
  // turned into a number by the expression and not drawn (bedrock-research, entity inventory UI 10.1).
  // live_horse_renderer projects the model itself, so it is drawn whatever the layer sum is; the model is about twice
  // as tall as the control, so the box clips it.
  "model": {
    "type": "image",
    "texture": "textures/ui/Black",
    "size": [ 52, 70 ],
    "layer": 1,
    "clips_children": true,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "holder": {
          "type": "panel",
          "size": [ 32, 32 ],
          "offset": [ 0, 4 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "renderer": {
                "type": "custom",
                "renderer": "live_horse_renderer",
                "layer": 2,
                "size": [ 32, 32 ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_control_name": "inventorymonitor_model",
                    "source_property_name": "(#saved - '§o' - '§f' - '§r')",
                    "target_property_name": "#entity_id"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "model_border": {
    "type": "image",
    "texture": "textures/ui/player_preview_border",
    "size": [ 54, 72 ],
    "layer": 0,
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  // The selection frame on the hotbar cell the target holds. The server writes "h<index>" as the name of the item in
  // slot 44 (a bare number would be read as a number); each frame shows only for its own index.
  "held_frame": {
    "type": "panel",
    "size": [ 22, 22 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "frame": {
          "type": "image",
          "texture": "textures/ui/selected_hotbar_slot",
          "size": [ 22, 22 ],
          "layer": 20,
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "inventorymonitor_held",
              "source_property_name": "((#saved - '§o' - '§f' - '§r') = $held_key)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  // A tab: a radio toggle of the group "inventorymonitor_tabs". The pages below follow the toggle "ender_tab".
  // The face reaches 6 pixels below the tab, over the top edge of the window, so the selected tab joins the window.
  // The icon is the item the server puts in the tab's slot (72 a chest, 73 an ender chest).
  "tab_face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "bg": { "type": "image", "texture": "$tab_texture", "size": [ "100%", "100% + 6px" ], "anchor_from": "top_left", "anchor_to": "top_left" } },
      {
        "icon": {
          "type": "custom",
          "renderer": "inventory_item_renderer",
          "layer": 1,
          "size": [ 16, 16 ],
          "property_bag": { "#item_id_aux": 0 },
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#item_id_aux", "binding_condition": "always" }
          ]
        }
      }
    ]
  },
  "tab": {
    "type": "toggle",
    "size": [ 22, 22 ],
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "toggle_name": "inventorymonitor_tabs",
    "radio_toggle_group": true,
    "toggle_group_forced_index": "$tab_index",
    "toggle_group_default_selected": 0,
    "toggle_default_state": "$tab_default",
    "toggle_on_button": "toggle.toggle_on",
    "toggle_off_button": "toggle.toggle_off",
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.menu_select", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.menu_ok", "mapping_type": "focused" }
    ],
    "checked_control": "on",
    "checked_hover_control": "on",
    "checked_locked_control": "on",
    "checked_locked_hover_control": "on",
    "unchecked_control": "off",
    "unchecked_hover_control": "off_hover",
    "unchecked_locked_control": "off",
    "unchecked_locked_hover_control": "off",
    "controls": [
      { "on@inventorymonitor.tab_face": { "$tab_texture": "textures/ui/TabTopFront" } },
      { "off@inventorymonitor.tab_face": { "$tab_texture": "textures/ui/TabTopBack" } },
      { "off_hover@inventorymonitor.tab_face": { "$tab_texture": "textures/ui/TabTopBackHover" } }
    ]
  },
  "tabs": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ 44, 22 ],
    "offset": [ 4, -22 ],
    "layer": 3,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "collection_name": "container_items",
    "controls": [
      {
        "inventory_tab@inventorymonitor.tab": {
          "collection_index": 72,
          "$tab_index": 0,
          "$tab_default": true
        }
      },
      {
        "ender_tab@inventorymonitor.tab": {
          "collection_index": 73,
          "$tab_index": 1,
          "$tab_default": false
        }
      }
    ]
  },

  // The items of one tab, shown while the "ender_tab" toggle has $tab_state
  "tab_page": {
    "type": "panel",
    "size": [ 162, 76 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      { "binding_type": "view", "binding_condition": "always", "source_control_name": "ender_tab", "source_property_name": "$tab_rule", "target_property_name": "#visible" }
    ]
  },

  // The target panel: armor, model, offhand, cursor and the items of the selected tab
  "target": {
    "type": "panel",
    "size": [ 162, 152 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "latches@inventorymonitor.latches": {} },
      { "model_border@inventorymonitor.model_border": { "offset": [ 19, 0 ] } },
      { "model@inventorymonitor.model": { "offset": [ 20, 1 ] } },
      {
        "cursor_caption@inventorymonitor.caption": {
          "$text": "inventorymonitor.cursor",
          "size": [ 40, 10 ],
          "text_alignment": "right",
          "offset": [ 100, 40 ]
        }
      },
      { "cell_36@inventorymonitor.cell": { "$index": 36, "offset": [ 0, 0 ], "$overlay": "inventorymonitor.helmet" } },
      { "cell_37@inventorymonitor.cell": { "$index": 37, "offset": [ 0, 18 ], "$overlay": "inventorymonitor.chestplate" } },
      { "cell_38@inventorymonitor.cell": { "$index": 38, "offset": [ 0, 36 ], "$overlay": "inventorymonitor.leggings" } },
      { "cell_39@inventorymonitor.cell": { "$index": 39, "offset": [ 0, 54 ], "$overlay": "inventorymonitor.boots" } },
      { "cell_40@inventorymonitor.cell": { "$index": 40, "offset": [ 76, 54 ], "$overlay": "inventorymonitor.shield" } },
      { "cell_41@inventorymonitor.cell": { "$index": 41, "offset": [ 144, 36 ] } },
      {
        "inventory_page@inventorymonitor.tab_page": {
          "$tab_rule": "(not #toggle_state)",
          "offset": [ 0, 76 ],
          "controls": [
            { "cell_9@inventorymonitor.cell": { "$index": 9, "offset": [ 0, 0 ] } },
            { "cell_10@inventorymonitor.cell": { "$index": 10, "offset": [ 18, 0 ] } },
            { "cell_11@inventorymonitor.cell": { "$index": 11, "offset": [ 36, 0 ] } },
            { "cell_12@inventorymonitor.cell": { "$index": 12, "offset": [ 54, 0 ] } },
            { "cell_13@inventorymonitor.cell": { "$index": 13, "offset": [ 72, 0 ] } },
            { "cell_14@inventorymonitor.cell": { "$index": 14, "offset": [ 90, 0 ] } },
            { "cell_15@inventorymonitor.cell": { "$index": 15, "offset": [ 108, 0 ] } },
            { "cell_16@inventorymonitor.cell": { "$index": 16, "offset": [ 126, 0 ] } },
            { "cell_17@inventorymonitor.cell": { "$index": 17, "offset": [ 144, 0 ] } },
            { "cell_18@inventorymonitor.cell": { "$index": 18, "offset": [ 0, 18 ] } },
            { "cell_19@inventorymonitor.cell": { "$index": 19, "offset": [ 18, 18 ] } },
            { "cell_20@inventorymonitor.cell": { "$index": 20, "offset": [ 36, 18 ] } },
            { "cell_21@inventorymonitor.cell": { "$index": 21, "offset": [ 54, 18 ] } },
            { "cell_22@inventorymonitor.cell": { "$index": 22, "offset": [ 72, 18 ] } },
            { "cell_23@inventorymonitor.cell": { "$index": 23, "offset": [ 90, 18 ] } },
            { "cell_24@inventorymonitor.cell": { "$index": 24, "offset": [ 108, 18 ] } },
            { "cell_25@inventorymonitor.cell": { "$index": 25, "offset": [ 126, 18 ] } },
            { "cell_26@inventorymonitor.cell": { "$index": 26, "offset": [ 144, 18 ] } },
            { "cell_27@inventorymonitor.cell": { "$index": 27, "offset": [ 0, 36 ] } },
            { "cell_28@inventorymonitor.cell": { "$index": 28, "offset": [ 18, 36 ] } },
            { "cell_29@inventorymonitor.cell": { "$index": 29, "offset": [ 36, 36 ] } },
            { "cell_30@inventorymonitor.cell": { "$index": 30, "offset": [ 54, 36 ] } },
            { "cell_31@inventorymonitor.cell": { "$index": 31, "offset": [ 72, 36 ] } },
            { "cell_32@inventorymonitor.cell": { "$index": 32, "offset": [ 90, 36 ] } },
            { "cell_33@inventorymonitor.cell": { "$index": 33, "offset": [ 108, 36 ] } },
            { "cell_34@inventorymonitor.cell": { "$index": 34, "offset": [ 126, 36 ] } },
            { "cell_35@inventorymonitor.cell": { "$index": 35, "offset": [ 144, 36 ] } },
            { "cell_0@inventorymonitor.cell": { "$index": 0, "offset": [ 0, 58 ] } },
            { "cell_1@inventorymonitor.cell": { "$index": 1, "offset": [ 18, 58 ] } },
            { "cell_2@inventorymonitor.cell": { "$index": 2, "offset": [ 36, 58 ] } },
            { "cell_3@inventorymonitor.cell": { "$index": 3, "offset": [ 54, 58 ] } },
            { "cell_4@inventorymonitor.cell": { "$index": 4, "offset": [ 72, 58 ] } },
            { "cell_5@inventorymonitor.cell": { "$index": 5, "offset": [ 90, 58 ] } },
            { "cell_6@inventorymonitor.cell": { "$index": 6, "offset": [ 108, 58 ] } },
            { "cell_7@inventorymonitor.cell": { "$index": 7, "offset": [ 126, 58 ] } },
            { "cell_8@inventorymonitor.cell": { "$index": 8, "offset": [ 144, 58 ] } },
            { "held_0@inventorymonitor.held_frame": { "$held_key": "h0", "offset": [ -2, 56 ] } },
            { "held_1@inventorymonitor.held_frame": { "$held_key": "h1", "offset": [ 16, 56 ] } },
            { "held_2@inventorymonitor.held_frame": { "$held_key": "h2", "offset": [ 34, 56 ] } },
            { "held_3@inventorymonitor.held_frame": { "$held_key": "h3", "offset": [ 52, 56 ] } },
            { "held_4@inventorymonitor.held_frame": { "$held_key": "h4", "offset": [ 70, 56 ] } },
            { "held_5@inventorymonitor.held_frame": { "$held_key": "h5", "offset": [ 88, 56 ] } },
            { "held_6@inventorymonitor.held_frame": { "$held_key": "h6", "offset": [ 106, 56 ] } },
            { "held_7@inventorymonitor.held_frame": { "$held_key": "h7", "offset": [ 124, 56 ] } },
            { "held_8@inventorymonitor.held_frame": { "$held_key": "h8", "offset": [ 142, 56 ] } }
          ]
        }
      },
      {
        "ender_page@inventorymonitor.tab_page": {
          "$tab_rule": "#toggle_state",
          "offset": [ 0, 76 ],
          "controls": [
            { "cell_45@inventorymonitor.cell": { "$index": 45, "offset": [ 0, 0 ] } },
            { "cell_46@inventorymonitor.cell": { "$index": 46, "offset": [ 18, 0 ] } },
            { "cell_47@inventorymonitor.cell": { "$index": 47, "offset": [ 36, 0 ] } },
            { "cell_48@inventorymonitor.cell": { "$index": 48, "offset": [ 54, 0 ] } },
            { "cell_49@inventorymonitor.cell": { "$index": 49, "offset": [ 72, 0 ] } },
            { "cell_50@inventorymonitor.cell": { "$index": 50, "offset": [ 90, 0 ] } },
            { "cell_51@inventorymonitor.cell": { "$index": 51, "offset": [ 108, 0 ] } },
            { "cell_52@inventorymonitor.cell": { "$index": 52, "offset": [ 126, 0 ] } },
            { "cell_53@inventorymonitor.cell": { "$index": 53, "offset": [ 144, 0 ] } },
            { "cell_54@inventorymonitor.cell": { "$index": 54, "offset": [ 0, 18 ] } },
            { "cell_55@inventorymonitor.cell": { "$index": 55, "offset": [ 18, 18 ] } },
            { "cell_56@inventorymonitor.cell": { "$index": 56, "offset": [ 36, 18 ] } },
            { "cell_57@inventorymonitor.cell": { "$index": 57, "offset": [ 54, 18 ] } },
            { "cell_58@inventorymonitor.cell": { "$index": 58, "offset": [ 72, 18 ] } },
            { "cell_59@inventorymonitor.cell": { "$index": 59, "offset": [ 90, 18 ] } },
            { "cell_60@inventorymonitor.cell": { "$index": 60, "offset": [ 108, 18 ] } },
            { "cell_61@inventorymonitor.cell": { "$index": 61, "offset": [ 126, 18 ] } },
            { "cell_62@inventorymonitor.cell": { "$index": 62, "offset": [ 144, 18 ] } },
            { "cell_63@inventorymonitor.cell": { "$index": 63, "offset": [ 0, 36 ] } },
            { "cell_64@inventorymonitor.cell": { "$index": 64, "offset": [ 18, 36 ] } },
            { "cell_65@inventorymonitor.cell": { "$index": 65, "offset": [ 36, 36 ] } },
            { "cell_66@inventorymonitor.cell": { "$index": 66, "offset": [ 54, 36 ] } },
            { "cell_67@inventorymonitor.cell": { "$index": 67, "offset": [ 72, 36 ] } },
            { "cell_68@inventorymonitor.cell": { "$index": 68, "offset": [ 90, 36 ] } },
            { "cell_69@inventorymonitor.cell": { "$index": 69, "offset": [ 108, 36 ] } },
            { "cell_70@inventorymonitor.cell": { "$index": 70, "offset": [ 126, 36 ] } },
            { "cell_71@inventorymonitor.cell": { "$index": 71, "offset": [ 144, 36 ] } }
          ]
        }
      }
    ]
  },

  // The viewer's own inventory (classic UI), from the same vanilla collections and grid items as the chest screen
  "own_inventory": {
    "type": "panel",
    "size": [ 162, 87 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "caption@inventorymonitor.caption": { "$text": "container.inventory" } },
      {
        "inventory_grid": {
          "type": "grid",
          "size": [ 162, 54 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 11 ],
          "grid_dimensions": [ 9, 3 ],
          "grid_item_template": "common.grid_item_for_inventory",
          "collection_name": "inventory_items"
        }
      },
      {
        "hotbar_grid": {
          "type": "grid",
          "size": [ 162, 18 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 69 ],
          "grid_dimensions": [ 9, 1 ],
          "grid_item_template": "common.grid_item_for_hotbar",
          "collection_name": "hotbar_items"
        }
      }
    ]
  },

  // The marker the vanilla screens look for: while it exists (a host is not ignored) they hide themselves.
  "entity_ui_hide_vanilla": {
    "type": "panel",
    "size": [ 0, 0 ],
    "property_bag": { "#entity_ui_vanilla_visible": false }
  },

  // A panel (a vanilla dialog texture, 9-sliced), moved down by half the tab height so the tabs on the top edge of the
  // target panel stay on the screen
  "window": {
    "type": "image",
    "texture": "textures/ui/dialog_background_opaque",
    "nineslice_size": 4,
    "layer": 0,
    "size": [ "100%", "100%" ],
    "offset": [ 0, 11 ]
  },

  // The whole screen. layer 1 on purpose: the item renderer does not draw above a layer sum of about 99.
  // ui/pocket_containers.json sets $im_pocket; each host is ignored unless the title has the key and the UI matches
  // (`ignored` is evaluated in the scope of the overlay, so the variables are declared here).
  "overlay": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 1,
    "$im_title": "$container_title",
