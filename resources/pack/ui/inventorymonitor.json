                  { "cell_6@inventorymonitor.cell": { "collection_index": 6, "offset": [ 108, 90 ] } },
                  { "cell_7@inventorymonitor.cell": { "collection_index": 7, "offset": [ 126, 90 ] } },
                  { "cell_8@inventorymonitor.cell": { "collection_index": 8, "offset": [ 144, 90 ] } },
                  { "cell_9@inventorymonitor.cell": { "collection_index": 9, "offset": [ 0, 32 ] } },
                  { "cell_10@inventorymonitor.cell": { "collection_index": 10, "offset": [ 18, 32 ] } },
