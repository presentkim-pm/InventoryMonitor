// Classic (desktop / tablet) UI: puts the InventoryMonitor screen (ui/inventorymonitor.json) into the vanilla small
// chest screen and hides the vanilla chest window while it is shown. Nothing is redeclared, see inventorymonitor.json.
//
// The screen draws its own window: the target on the left and the viewer's inventory on the right, from the same
// vanilla collections. So the vanilla window background (with its close button), the chest cells, the player's
// inventory and the hotbar are all hidden; the path keys are applied by the Windows client (ui_tree shows them hidden).
{
  "namespace": "chest",

  "small_chest_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [ { "inventorymonitor_overlay@inventorymonitor.overlay": {} } ]
      }
    ]
  },

  "small_chest_panel/root_panel/common_panel": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_control_name": "entity_ui_hide_vanilla",
            "source_property_name": "#entity_ui_vanilla_visible",
            "target_property_name": "#visible",
            "binding_condition": "always"
          }
        ]
      }
    ]
  },

  "small_chest_panel/root_panel/chest_panel/small_chest_panel_top_half": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_control_name": "entity_ui_hide_vanilla",
            "source_property_name": "#entity_ui_vanilla_visible",
            "target_property_name": "#visible",
            "binding_condition": "always"
          }
        ]
      }
    ]
  },

  "small_chest_panel/root_panel/chest_panel/inventory_panel_bottom_half_with_label": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_control_name": "entity_ui_hide_vanilla",
            "source_property_name": "#entity_ui_vanilla_visible",
            "target_property_name": "#visible",
            "binding_condition": "always"
          }
        ]
      }
    ]
  },

  "small_chest_panel/root_panel/chest_panel/hotbar_grid": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_control_name": "entity_ui_hide_vanilla",
            "source_property_name": "#entity_ui_vanilla_visible",
            "target_property_name": "#visible",
            "binding_condition": "always"
          }
        ]
      }
    ]
  }
}
