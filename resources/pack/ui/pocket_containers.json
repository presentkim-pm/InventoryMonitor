// Pocket UI: puts the InventoryMonitor target panel (ui/inventorymonitor.json) into the vanilla container panel.
// The panel has two halves: "inventory" (the player's own inventory, left) and "container" (the chest, right). Only the
// container half and its header are hidden while the screen is shown (the marker control "entity_ui_hide_vanilla"
// exists only then); the player's inventory, the close button and the background stay, so shift-click works.
{
  "namespace": "pocket_containers",

  "panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [ { "inventorymonitor_overlay@inventorymonitor.overlay": { "$im_pocket": true } } ]
      }
    ]
  },

  "panel/container": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_control_name": "entity_ui_hide_vanilla",
            "source_property_name": "#entity_ui_vanilla_visible",
            "target_property_name": "#visible",
            "binding_condition": "always"
          }
        ]
      }
    ]
  },

  "header_area/container_header": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_control_name": "entity_ui_hide_vanilla",
            "source_property_name": "#entity_ui_vanilla_visible",
            "target_property_name": "#visible",
            "binding_condition": "always"
          }
        ]
      }
    ]
  }
}
